# ============================================================
#  旁听生 —— 配置模板
#  用法：复制成 .env，把空着的填上（只有 API_KEY / WS_* / OWNER_QQ 是必须的）
#  启动：node --env-file=.env bot.mjs
# ============================================================

# ---------- NapCat / OneBot（必填）----------
# NapCat 里配的 OneBot 11 WebSocket 服务端地址
WS_URL=ws://127.0.0.1:3001
# 同一个地方配的 token，填到这边；两边要一致
WS_TOKEN=

# ---------- 模型 API（必填）----------
# OpenAI 兼容地址：DeepSeek / 智谱 / 通义 / Moonshot 都行
API_BASE=https://api.deepseek.com/v1
# 去 https://platform.deepseek.com 申请
API_KEY=
# 对话模型
MODEL=deepseek-chat
# 能不能看图（消息里带图片时）
VISION=true
# 留空 = 用上面那个 MODEL
VISION_MODEL=
# 越高越飘，聊天可以高一点
TEMPERATURE=1.2
# 每个会话保留几轮上下文（超了压成摘要）
MAX_TURNS=10

# ---------- 人设 ----------
# 人设文件；一行都没填的话用下面的 SYSTEM_PROMPT
SYSTEM_PROMPT_FILE=personas/00_示例人设.txt
# 没有 SYSTEM_PROMPT_FILE 时的兜底
SYSTEM_PROMPT=你是一个QQ群里的AI助手，说话简洁自然，不啰嗦。

# ---------- 主人 ----------
# 你的 QQ 号；认主人、私聊、主动找人都靠它
OWNER_QQ=
# 她平时怎么叫你
OWNER_ALIAS=
# 和主人的对话上下文留多久（分钟），0 = 永久
OWNER_MEMORY_MINUTES=0
# 认识的人留 24 小时
KNOWN_MEMORY_MINUTES=1440
# 陌生人留 12 小时
STRANGER_MEMORY_MINUTES=720

# ---------- 群聊准入 ----------
# 群里要 @ 她才回；false = 一视同仁地接话（会吵）
GROUP_NEED_AT=true
# 主人群里免 @（默认关：一视同仁）
GROUP_OWNER_NO_AT=false
# 只理这些群，逗号分隔；空 = 全部群
GROUP_WHITELIST=
# 群里没 @ 她的消息也打一行日志，方便排查「她怎么不理人」
GROUP_DEBUG=true
# @她一次之后开接力窗口，接下来几句不用重复 @
GROUP_FOLLOW=true
# 窗口里还能连说几句
GROUP_FOLLOW_TURNS=3
# 窗口多久不用就作废
GROUP_FOLLOW_MINUTES=5
# 让她知道自己是群管理员，被挑衅时可以禁言对方
GROUP_ADMIN=true
# 禁言默认时长（对方自己报时长就按他的来）
GROUP_BAN_MINUTES=10
# 每分钟最多回几条，防刷屏
RATE_PER_MIN=15

# ---------- 群里的记性 ----------
# 拉群成员名单（花名册），认得出谁是谁
GROUP_ROSTER=true
# 多久刷新一次名单
GROUP_ROSTER_MINUTES=30
# 旁听：没 @ 她的消息也记下来，被叫到时有前情
GROUP_EAVESDROP=true
# 每群记最近多少条
GROUP_LOG_SIZE=20
# 给群友建档案（这人什么脾气、雷区在哪）
GROUP_MATE=true
# 聊几轮整理一次
GROUP_MATE_EVERY=4
# 每人最多记几条
GROUP_MATE_MAX=8

# ---------- 长期记忆 ----------
# 自动从对话里提炼长期记忆
MEMORY_AUTO=true
# 每聊几轮提炼一次
MEMORY_AUTO_EVERY=4
# 每人最多存几条
MEMORY_AUTO_MAX=40
# 上下文太长就压成摘要，不直接丢
CONTEXT_SUMMARY=true
# 一次压缩几轮
SUMMARY_BATCH=6
# 定期整理「她心里对你的印象」
PROFILE_AUTO=true
# 每聊几轮整理一次
PROFILE_EVERY=6
# 记住自己答应过的事，拖久了会翻旧账
PROMISES=true
# 最多记几条
PROMISE_MAX=20
# 答应的事过了多久还没做就提一嘴
PROMISE_NUDGE_HOURS=24
# 有人加好友/进群时打个日志
REQUEST_NOTIFY=true
# 同时私聊告诉你
REQUEST_NOTIFY_OWNER=true

# ---------- 说话方式 ----------
# 单条消息上限，超了自动分段
MAX_MSG_LEN=800
# 同一会话最小发送间隔（毫秒）
MIN_SEND_INTERVAL=2000
# 长回复拆成几条发，像人打字
LINE_SPLIT=true
# 每行大概几个字就断
LINE_WIDTH=16
# 最多拆成几条
LINE_MAX=6
# 两条之间最少隔多久（毫秒）
LINE_GAP_MIN=350
# 最多隔多久
LINE_GAP_MAX=900
# 最后一条拆多碎
LINE_TAIL_RATIO=0.5
# 回复前的思考停顿（毫秒）
REPLY_DELAY_MIN=800
# 同上限
REPLY_DELAY_MAX=2500
# 按字数再加一点打字时间
TYPE_MS_PER_CHAR=45
# 回复时引用原消息
REPLY_QUOTE=true
# 连发几条时等多久合并成一轮
DEBOUNCE_MS=1200
# 连发合并后只编一次号
DEDUPE_BURSTS=true
# 加一句口头禅的概率（%）
FLAVOR_ODDS=15
# 幽默招式轮盘（偶尔毒舌一句）
HUMOR=true
# 口头禅稀释，别让她一句话重复三遍
CATCHPHRASE_GUARD=true

# ---------- 情绪 ----------
# 情绪值，会自己消气
MOOD=true
# 每轮自己消多少
SULK_DECAY_PER_TURN=8
# 每 10 分钟自己消多少
SULK_DECAY_PER_10MIN=15
# 超过这个值开始话少
SULK_QUIET_AT=60
# 低于这个值恢复正常
SULK_RECOVER_AT=20

# ---------- 读人与安全墙 ----------
# 把「哦」「随便」这种翻成底下那层意思
SUBTEXT=true
# 一轮最多参考几条
SUBTEXT_MAX=3
# 安全墙：敏感词按 data/safety.txt 处理
SAFETY=true

# ---------- 梗库 ----------
# 开梗库；没有 data/梗库.md 就自动关
MEME_LIB=true
# 梗库文件
MEME_FILE=data/梗库.md
# 一轮最多检索几条（常驻的不算）
MEME_TOP=4

# ---------- 表情包 ----------
# 能从仓库里挑表情包发
STICKERS=true
# 表情包目录（自己往里丢图，索引会自动建）
STICKER_DIR=stickers
# 最多存几张
STICKER_MAX=300
# 0 = 只在合适的时候发；调大就更容易发
STICKER_CHANCE=0
# 一条消息最多处理几张图
MAX_IMAGES=3
# 单图上限
MAX_IMAGE_MB=8

# ---------- 主动与戳一戳 ----------
# 被戳一戳会回
POKE=true
# 每人每小时最多回应几次
POKE_MAX_PER_HOUR=6
# 会主动找人说话
PROACTIVE=true
# 几点到几点之间才开口
PROACTIVE_HOURS=9-23
# 巡检时开口的概率（%）
PROACTIVE_CHANCE=25
# 隔多久没聊才想起你
PROACTIVE_IDLE_MINUTES=240
# 两次主动之间至少隔多久
PROACTIVE_MIN_GAP_MINUTES=360
# 多久巡检一次
PROACTIVE_CHECK_MINUTES=5
# owner = 只找主人；owner+known = 熟人也找
PROACTIVE_WHO=owner

# ---------- 语音 ----------
# 能发语音（文字末尾加「（语音）」就回语音）
VOICE=true
# edge = 微软在线 TTS（14 把嗓子、能点单、要联网）；local = 本地 sherpa-onnx（不联网、慢）
VOICE_ENGINE=edge
# edge 模式下的默认嗓子
VOICE_NAME=zh-CN-XiaoyiNeural
# 超过这么多字就退回打字
VOICE_MAX_CHARS=120
# local 模式下 kokoro 超过这么多字自动换快声模型
VOICE_KOKORO_MAX=60
# local 模型：kokoro（好听但慢）/ melo（快）/ ll（五个音色）
VOICE_LOCAL_MODEL=kokoro
# kokoro 中文女声用 47；melo 只有 0
VOICE_LOCAL_SID=47
# 本地合成的线程数，0 = 自动（4）
VOICE_THREADS=0

# ---------- 控制台 ----------
# 面板端口，只绑 127.0.0.1:http://127.0.0.1:3010
PANEL_PORT=3010
# 状态文件目录，一般不用改
PANEL_DIR=.

# ---------- 日志与调试 ----------
# 日志文件
LOG_FILE=bot.log
# 超过就切一份
LOG_MAX_MB=5
# 最多留几份
LOG_KEEP=5
# 设 1 = 把每次的 system 提示词落盘，调提示词时用
DUMP_PROMPT=0
# 落盘到哪
DUMP_PROMPT_FILE=data/last-prompt.txt

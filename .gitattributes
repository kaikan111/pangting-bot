# 默认一切按文本处理、仓库里统一 LF（避免 core.autocrlf=true 引起的行尾噪音）
* text=auto eol=lf

# Windows 脚本必须保持 CRLF，否则 PS 5.1 / cmd 解释器可能读错行
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 其余统一 LF，diff 干净
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf

# 二进制
*.wav binary
*.mp3 binary
*.png binary
*.jpg binary
*.gif binary
